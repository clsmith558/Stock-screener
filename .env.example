# Required for SEC EDGAR API (https://www.sec.gov/os/accessing-edgar-data)
SEC_EDGAR_IDENTITY=you@example.com
SCREENER_CONTACT_EMAIL=you@example.com

# Optional — Obsidian vault integration (enrich_ticker.py --export-vault, export_registry.py)
OBSIDIAN_VAULT_PATH=C:/Obsidian/your-vault

# Supporting series collectors (EIA + FRED). Free keys; leave blank until used.
# EIA: https://www.eia.gov/opendata/   FRED v1: https://fredaccount.stlouisfed.org/apikeys
EIA_API_KEY=
FRED_API_KEY=

# --- Server (personal / local defaults) ---
# Bind address. Prefer 127.0.0.1 so the screener is not reachable on the LAN.
SCREENER_HOST=127.0.0.1
SCREENER_PORT=5000
# Flask debug reloader + interactive debugger (never enable if the host is not loopback)
# FLASK_DEBUG=1

# Optional shared secret for POST/refresh/scrape routes. When set, the dashboard
# injects it automatically; scripts must send header: X-Screener-Token: <value>
# SCREENER_API_TOKEN=

# Allow mutating API calls from non-localhost clients (default off). Only set if
# you intentionally bind SCREENER_HOST=0.0.0.0 and understand the risk.
# SCREENER_ALLOW_REMOTE=0

# Daily Pitch Email Dispatch (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=
PITCH_EMAIL_RECIPIENT=you@example.com

